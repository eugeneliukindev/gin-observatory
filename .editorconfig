root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# gofmt indents with tabs.
[{*.go,go.mod}]
indent_style = tab

[*.{yml,yaml,json}]
indent_style = space
indent_size = 2

[*.toml]
indent_style = space
indent_size = 4

[justfile]
indent_style = space
indent_size = 4
